{
  "system": "AgentGraph",
  "version": "3.0.0",
  "description": "AI-native product delivery platform. 40 agents, 9 product types, 17 quality gates.",
  "ai_entry_point": "Run 'guild' with no arguments or 'guild help --json' for full system schema.",
  "ai_mode": "Set AG_AI_MODE=1 or use --json flag on any command for structured output.",
  "quick_start_for_ai": {
    "discover": "guild help --json",
    "plan": "guild plan --json '<task description>'",
    "check_capability": "guild capability <type> --json",
    "init_project": "guild init --template <name> <dir>",
    "dispatch_agent": "guild dispatch <agent> '<task>'",
    "run_quality_gate": "guild gate --handoff <id> --json",
    "check_health": "guild doctor --json"
  },
  "commands": {
    "plan": {
      "description": "Full execution plan: classify → team matching → graph selection → milestones → risks",
      "usage": "guild plan [--json] '<task description>'",
      "input": {
        "task": "string (natural language)"
      },
      "output_json": {
        "summary": "string",
        "product_type": "string",
        "label": "string",
        "confidence": "number",
        "team": {
          "lead": "string",
          "members": "array"
        },
        "flow": {
          "graph": "string"
        },
        "gates": "string",
        "risks": "array"
      },
      "example": "guild plan --json '帮我做塔罗小程序'"
    },
    "capability": {
      "description": "Show product type capabilities (agents, modules, gates)",
      "usage": "guild capability <type> [--json]",
      "output_json": {
        "type": "string",
        "label": "string",
        "agents": [
          "string"
        ],
        "modules": [
          "string"
        ],
        "gates": "string",
        "template": "string",
        "metrics": [
          "string"
        ]
      },
      "types": [
        "wechat-game",
        "miniapp",
        "web-app",
        "dashboard",
        "api-service",
        "landing-page",
        "corp-site",
        "admin-system",
        "mobile-app",
        "research-report",
        "strategy-consulting",
        "brand-identity",
        "visual-design",
        "content-project",
        "unity-game",
        "unreal-game",
        "infra-project",
        "ai-ml-project"
      ]
    },
    "capabilities": {
      "description": "List all 18 product types with capabilities",
      "usage": "guild capabilities [--json]"
    },
    "classify": {
      "description": "Classify a natural language task into a product type with confidence score",
      "usage": "guild classify [--json] '<task description>'",
      "input": {
        "task": "string (natural language)"
      },
      "output_json": {
        "type": "string",
        "label": "string",
        "confidence": "number (0-1)",
        "alternatives": "array",
        "template": "string",
        "gates": "string"
      },
      "example": "guild classify --json '做一个供应商后台管理系统'"
    },
    "init": {
      "description": "Initialize project from template",
      "usage": "guild init --template <name> <directory>",
      "templates": [
        "wechat-game",
        "miniapp",
        "web-app",
        "dashboard",
        "api-service",
        "landing-page",
        "corp-site",
        "admin-system",
        "mobile-app"
      ]
    },
    "dispatch": {
      "description": "Dispatch agent with full context (identity + memory + task)",
      "usage": "guild dispatch <agent-slug> '<task>' [--json]",
      "output_json": {
        "agent": "string",
        "task": "string",
        "dispatch_id": "string",
        "memory_context": [
          "string"
        ]
      }
    },
    "execute": {
      "description": "Full agent execution (dispatch + track + complete)",
      "usage": "guild execute <agent-slug> '<task>' [--input <json>]"
    },
    "complete": {
      "description": "Mark agent dispatch as complete + save to memory",
      "usage": "guild complete <dispatch-id> '<summary>'"
    },
    "chain": {
      "description": "Generate full agent execution chain for a task",
      "usage": "guild chain '<task>' [--json]",
      "output_json": {
        "task": "string",
        "type": "string",
        "agents": [
          {
            "order": "number",
            "slug": "string",
            "name": "string",
            "dispatch_command": "string"
          }
        ]
      }
    },
    "gate": {
      "description": "Run quality gates on a handoff",
      "usage": "guild gate --handoff <id> [--gate <1-5>] [--json]",
      "gates": {
        "1": "completeness — all required deliverables present",
        "2": "syntax — all files pass syntax validation",
        "3": "behavior — 17 behavioral checks pass",
        "4": "playability — UX checks (tutorial, audio, mobile)",
        "5": "agent-standards — agent success criteria met"
      },
      "output_json": {
        "handoff_id": "number",
        "passed": "number",
        "failed": "number",
        "total": "number",
        "results": [
          {
            "gate": "string",
            "status": "pass|fail",
            "details": "string"
          }
        ]
      }
    },
    "fix": {
      "description": "Auto-fix common gate failures",
      "usage": "guild fix --file <path> [--all] [--dry-run] [--list]",
      "strategies": [
        "state-management",
        "audio-gesture",
        "viewport-meta",
        "localStorage-try-catch",
        "replayability",
        "canvas-safety",
        "province-blocking"
      ]
    },
    "doctor": {
      "description": "System health check (7 checks)",
      "usage": "guild doctor [--json]"
    },
    "test-runtime": {
      "description": "Browser-based runtime testing",
      "usage": "guild test-runtime --file <path> [--json]"
    },
    "status": {
      "description": "Show project status (handoffs, dispatches, memory)",
      "usage": "guild status [--handoffs] [--dispatches] [--all] [--json]"
    },
    "agents": {
      "description": "List all 40 available agents",
      "usage": "guild agents [--json]"
    },
    "prompt": {
      "description": "Get agent's full identity as LLM system prompt",
      "usage": "guild prompt <agent-slug> [--json]"
    },
    "task": {
      "description": "Get agent's full task execution prompt",
      "usage": "guild task <agent-slug> '<task description>' [--json]"
    },
    "memory": {
      "description": "View/save agent memory",
      "usage": "guild memory <agent> [--save '<task>' '<summary>'] [--all]"
    },
    "self-test": {
      "description": "Run system self-tests",
      "usage": "guild self-test [--quick]"
    },
    "ci-test": {
      "description": "Fast CI smoke tests (10 checks, <30s)",
      "usage": "guild ci-test"
    },
    "templates": {
      "description": "List available project templates",
      "usage": "guild templates"
    },
    "handoff": {
      "description": "Create a handoff between agents",
      "usage": "guild handoff --from <agent> --to <agent> --path <dir> [--message <msg>]"
    },
    "check": {
      "description": "Check handoff status",
      "usage": "guild check --handoff <id>"
    },
    "cleanup": {
      "description": "Clean stale handoffs",
      "usage": "guild cleanup [--stale]"
    }
  },
  "agents": {
    "product": [
      "product-manager",
      "ux-researcher",
      "data-analyst",
      "tech-writer"
    ],
    "design": [
      "ui-designer",
      "brand-guardian",
      "interaction-designer",
      "creative-director"
    ],
    "engineering": [
      "frontend-engineer",
      "backend-architect",
      "database-specialist",
      "devops-engineer",
      "mobile-developer",
      "ai-engineer",
      "code-reviewer"
    ],
    "testing": [
      "qa-engineer",
      "performance-tester",
      "accessibility-auditor"
    ],
    "security": [
      "security-engineer"
    ],
    "marketing": [
      "growth-hacker",
      "content-creator",
      "seo-specialist",
      "social-media-strategist"
    ],
    "game-development": [
      "game-designer",
      "game-programmer",
      "technical-artist",
      "game-ui-designer",
      "game-audio-engineer",
      "monetization-designer",
      "game-qa-engineer",
      "game-producer"
    ],
    "project-management": [
      "project-manager"
    ],
    "sales": [
      "sales-engineer",
      "deal-strategist"
    ],
    "support": [
      "customer-support"
    ],
    "finance": [
      "financial-analyst"
    ]
  },
  "gates": {
    "1_completeness": "所有必需交付物已提供",
    "2_syntax": "所有文件语法验证通过",
    "3_behavior": "17项行为测试通过(代码质量+UX+物理)",
    "4_playability": "可玩性检查(教程/音效/UX流程/移动端)",
    "5_agent_standards": "Agent成功标准逐条验证"
  },
  "ai_workflow_example": {
    "task": "做一个供应商后台管理系统",
    "steps": [
      {
        "command": "guild plan --json '...'",
        "purpose": "AI分析任务→选型→构图"
      },
      {
        "command": "guild capability admin-system --json",
        "purpose": "查看该类型的Agent/模块/Gate"
      },
      {
        "command": "guild init --template admin-system ./project",
        "purpose": "初始化项目脚手架"
      },
      {
        "command": "guild chain '...' --json",
        "purpose": "生成完整Agent执行链"
      },
      {
        "command": "guild dispatch product-manager '写PRD'",
        "purpose": "派发第一个Agent"
      },
      {
        "command": "guild complete <id> 'PRD完成: 10个用户故事'",
        "purpose": "标记Agent完成"
      },
      {
        "command": "guild gate --handoff <id> --json",
        "purpose": "质量门禁验证"
      },
      {
        "command": "guild fix --file <path> --all",
        "purpose": "自动修复Gate失败项"
      }
    ]
  },
  "error_handling": {
    "pattern": "All errors follow: { error: 'message', fix: 'suggestion', help: 'guild help <command>' }",
    "common_errors": {
      "unknown_agent": {
        "fix": "Run 'guild agents' to see all 40 available agents"
      },
      "unknown_template": {
        "fix": "Run 'guild templates' to see available templates"
      },
      "gate_failed": {
        "fix": "Run 'guild fix --file <path> --all' to auto-fix, or check specific failures with 'guild gate --handoff <id> --json'"
      }
    }
  },
  "mcp_integration": {
    "description": "AgentGraph exposes ALL capabilities as MCP tools. AI hosts call functions directly, no bash parsing.",
    "registration": {
      "claude_code": "Add to .mcp.json: mcpServers.agentgraph = node scripts/mcp-server.js",
      "openclaw": "Register as MCP server: node scripts/mcp-server.js",
      "hermes": "Register as MCP server: node scripts/mcp-server.js",
      "generic": "node scripts/mcp-server.js --http 3000"
    },
    "tools_count": 14
  },
  "cross_platform": {
    "claude_code": {
      "mcp": true,
      "bash": true
    },
    "openclaw": {
      "mcp": true,
      "bash": true,
      "http": true
    },
    "hermes": {
      "mcp": true,
      "bash": true
    },
    "standalone": {
      "bash": true
    }
  }
}