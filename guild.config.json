    "game-development": { "label": "Game Development", "icon": "Gamepad2", "color": "#A855F7" }
  },
  "tools": {
    "claude-code": {
      "label": "Claude Code", "format": "identity", "installKind": "per-agent",
      "dest": { "user": [".claude/agents/{slug}.md"], "project": [".claude/agents/{slug}.md"] }
    },
    "cursor": {
      "label": "Cursor", "format": "cursor-mdc", "installKind": "per-agent",
      "dest": { "user": [], "project": [".cursor/rules/{slug}.mdc"] }
    },
    "copilot": {
      "label": "GitHub Copilot", "format": "identity", "installKind": "per-agent",
      "dest": { "user": [".github/agents/{slug}.md", ".copilot/agents/{slug}.md"], "project": [".github/agents/{slug}.md"] }
    },
    "windsurf": {
      "label": "Windsurf", "format": "windsurf-rules", "installKind": "roster",
      "dest": { "user": [], "project": [".windsurfrules"] }
    }
  },
