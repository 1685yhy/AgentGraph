{
  "name": "research-report",
  "label": "研究报告",
  "description": "用户调研、竞品分析、市场研究报告",
  "version": "0.1.0",
  "init_command": "guild init --template research-report <project-dir>",
  "capabilities": {
    "agents": [
      "product-manager",
      "ux-researcher",
      "data-analyst",
      "tech-writer"
    ],
    "modules": [
      "analytics"
    ],
    "gates": "1 2",
    "metrics": [
      "report_completeness",
      "insight_quality",
      "recommendation_actionability"
    ]
  }
}
