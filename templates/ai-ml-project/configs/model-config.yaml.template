# AgentGraph AI/ML Template — Model Config
# Agent: ai-engineer
# Produces: model-configuration

model:
  type: ""                    # e.g., "bert-base", "gpt2", "resnet50"
  pretrained: true
  num_labels: 2

training:
  batch_size: 32
  learning_rate: 2e-5
  epochs: 3
  warmup_steps: 500
  weight_decay: 0.01
  max_grad_norm: 1.0

data:
  max_seq_length: 512
  train_split: 0.8
  shuffle: true
  seed: 42

output:
  save_steps: 500
  eval_steps: 500
  logging_steps: 100
  metric: "accuracy"
